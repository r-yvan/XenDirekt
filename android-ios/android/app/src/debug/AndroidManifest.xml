<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development (hot reload, debugging). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: allow plain HTTP to the local API (10.0.2.2). Release builds forbid it. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic"/>
</manifest>
