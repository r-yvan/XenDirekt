{
  "name": "xendirekt-web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "XenDirekt website (waitlist, Hustle Check, Wall of Hustle) and web portal",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-strip-types \"lib/**/*.test.ts\"",
    "qa:screens": "node --experimental-strip-types scripts/qa-screens.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
