{
  "name": "xendirekt-api",
  "version": "0.1.0",
  "description": "XenDirekt payment orchestration API (NestJS modular monolith)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:contract": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects contract",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --selectProjects e2e --runInBand",
    "test:all": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "db:migrate": "tsx src/database/cli/migrate.ts latest",
    "db:migrate:down": "tsx src/database/cli/migrate.ts down",
    "db:seed": "tsx src/database/cli/seed.ts",
    "admin:create": "nest build && node dist/modules/admin/cli/create-admin.js",
    "openapi:export": "nest build && node dist/scripts/export-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@prometheus-io/client": "^0.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "kysely": "^0.29.7",
    "libphonenumber-js": "^1.13.15",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
