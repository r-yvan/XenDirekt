# XenDirekt API — environment template. Copy to .env for local development.
# NEVER commit real values. Deployed environments read these from a secret manager.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Generate FIELD_ENCRYPTION_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Runtime ---------------------------------------------------------------
# local | test | sandbox | staging | production
APP_ENV=local
PORT=3000
# Base URL the API is reachable at (used for hosted-page return URLs). https required in production.
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API (none needed for the mobile app).
CORS_ALLOWED_ORIGINS=
# Swagger UI at /docs (always on in local/test; must be false in production).
ENABLE_API_DOCS=false

# --- Data ------------------------------------------------------------------
DATABASE_URL=postgresql://xendirekt:xendirekt@localhost:55432/xendirekt_dev
DATABASE_POOL_MAX=10
# disable | require (require in production)
DATABASE_SSL=disable
# Required in production (shared rate limits). Local runs fall back to in-memory counters.
REDIS_URL=redis://localhost:6379

# inline (worker loops inside the API process; local/test only) | separate | disabled
WORKER_MODE=inline

# --- Secrets (replace every value) -------------------------------------------
JWT_ACCESS_SECRET=replace-with-32-random-bytes-base64url-xxxxxxxxxxxxxx
JWT_ADMIN_SECRET=replace-with-32-random-bytes-base64url-xxxxxxxxxxxxxxx
OTP_HMAC_SECRET=replace-with-32-random-bytes-base64url-xxxxxxxxxxxxxxxx
PIN_PEPPER=replace-with-32-random-bytes-base64url-xxxxxxxxxxxxxxxxxxxxx
# Exactly 32 bytes, standard base64.
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FIELD_ENCRYPTION_KEY_ID=k1

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_TTL_HOURS=12

# --- Payment provider ----------------------------------------------------------
# mock (local/test/sandbox only; forbidden in production) | xentripay
PAYMENT_PROVIDER=mock
MOCK_PROVIDER_LATENCY_MS=150
# HMAC secret for the mock provider's test webhook contract (non-production only).
MOCK_WEBHOOK_SECRET=replace-with-32-random-bytes-base64url-xxxxxxxxxxxxx

XENTRIPAY_BASE_URL=https://merchant.test.xentripay.com
XENTRIPAY_API_KEY=
XENTRIPAY_CONNECT_TIMEOUT_MS=3000
XENTRIPAY_RESPONSE_TIMEOUT_MS=10000
# Production refuses to start unless every critical capability has evidence, e.g.
# PAYOUT_STATUS=EV-2026-11-04-sandbox-run;CARD_VOID=EV-...   (see docs/provider-capability-matrix.md)
PROVIDER_CAPABILITY_APPROVALS=

# --- Notifications ---------------------------------------------------------------
# smtp | disabled  (Mailpit from docker-compose listens on 1025, UI on http://localhost:8025)
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=XenDirekt <no-reply@xendirekt.local>
# disabled | dev-email-bridge (local/test only: SMS text is delivered to Mailpit)
SMS_TRANSPORT=dev-email-bridge
PUSH_TRANSPORT=disabled

# --- Operations ------------------------------------------------------------------
# Bearer token required to scrape /metrics (required in production).
METRICS_TOKEN=

# --- Features --------------------------------------------------------------------
# MoMo Pay merchant codes: keep false until the partner confirms the capability.
FEATURE_MERCHANT_CODES=false
# Apple/Google sign-in: keep false until client IDs exist.
FEATURE_FEDERATED_SIGN_IN=false
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# --- Legal -------------------------------------------------------------------------
TERMS_VERSION=2026-10-01
PRIVACY_VERSION=2026-10-01
TERMS_URL=https://xendirekt.example/terms
PRIVACY_URL=https://xendirekt.example/privacy
